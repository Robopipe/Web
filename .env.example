# Database (local dev: docker compose up -d)
DATABASE_URL=postgres://payload:payload@localhost:5432/robopipe

# Payload
PAYLOAD_SECRET=change-me
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Email (Resend) — optional in dev; emails are logged to console when unset
RESEND_API_KEY=

# Media storage (Google Cloud Storage) — optional in dev; falls back to local ./media when unset.
# The bucket must be publicly readable. GCS_CREDENTIALS is a service-account key JSON on one line.
GCS_BUCKET=
GCS_CREDENTIALS=

# Analytics (Plausible) — optional; script only rendered when set
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Draft preview
PREVIEW_SECRET=change-me

# AI blog generation (Claude) — required for the blog-topics generation job
ANTHROPIC_API_KEY=
# Hero image search for generated posts
PEXELS_API_KEY=
# Shared secret for the scheduled task → /api/cron/run-jobs endpoint
CRON_SECRET=
